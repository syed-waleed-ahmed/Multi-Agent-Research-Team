# ---------------------------------------------------------------------------
# Multi-Agent Research Team - environment configuration
# Copy this file to `.env` and fill in your credentials. Never commit `.env`.
# ---------------------------------------------------------------------------

# ===========================================================================
# Research engine (CLI and web app)
# ===========================================================================

# --- Required credentials (both have no-card free tiers) -------------------
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Serper (Google results): https://serper.dev  — or set TAVILY_API_KEY instead
SERPER_API_KEY=your_serper_api_key_here

# --- Optional fallback web search (free monthly credits) -------------------
# TAVILY_API_KEY=
# SEARCH_PROVIDERS=serper,tavily      # order in which search providers are tried

# --- Model ------------------------------------------------------------------
# Groq retired its Llama 3.x chat models in 2026. Current options (2026-11):
#   openai/gpt-oss-120b (default), openai/gpt-oss-20b (faster), qwen/qwen3.8-27b
# Free tier (verified 2026-11): 1,000 requests/day and 8,000 tokens/minute PER MODEL.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
# Larger output budget for the Manager Agent's final report.
SYNTHESIS_MAX_TOKENS=3072
# Retries for a single failed model request (backoff + jitter, honours Retry-After).
GROQ_MAX_RETRIES=3
# Seconds one request may wait out rate limits (free-tier TPM windows reset each minute).
RATE_LIMIT_MAX_WAIT_SECONDS=60
# Reasoning budget for reasoning models (gpt-oss, qwen3): low | medium | high
REASONING_EFFORT=low

# --- Optional: other providers / fallbacks -----------------------------------
# LLM_PROVIDER=groq                   # groq | gemini | openrouter | openai_compatible | ollama
# LLM_FALLBACK_PROVIDERS=groq:openai/gpt-oss-20b,gemini   # 'provider' or 'provider:model',
#                                   # tried in order when the current one stays rate-limited
# GEMINI_API_KEY=                     # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=                 # https://openrouter.ai/keys (":free" models)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1   # LM Studio, vLLM, ...
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Optional operational guard rails -----------------------------------------
# MAX_RPM=30            # cap requests-per-minute across the agents
# REQUEST_TIMEOUT=120   # per-agent execution timeout in seconds
# WORKFLOW_TIMEOUT=600  # wall-clock budget for a whole CLI run in seconds

LOG_LEVEL=INFO

# CrewAI telemetry and tracing are disabled by the app by default.
# CREWAI_DISABLE_TELEMETRY=false
# CREWAI_TRACING_ENABLED=true

# ===========================================================================
# Web application (research-team-web)
# ===========================================================================

# --- Persistence ------------------------------------------------------------
# Default: SQLite file. On hosts with an ephemeral disk (e.g. Render Free) data
# is lost on restart; use a free Postgres instead, e.g. Neon:
#   DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
# DATABASE_URL=sqlite:///./data/research.db

# --- Server -------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1   # proxies trusted for X-Forwarded-Proto ("*" on PaaS)
# CLIENT_IP_HEADERS=              # headers your edge proxy OVERWRITES with the client IP
#                                 # (Render/Cloudflare: CF-Connecting-IP)
# TRUSTED_PROXY_HOPS=0            # trusted reverse proxies for X-Forwarded-For (fallback)
# CORS_ORIGINS=                   # only for split hosting, e.g. https://your-site.pages.dev
# ENABLE_API_DOCS=true            # interactive docs at /api/docs
# IP_HASH_SALT=                   # secret salt for pseudonymising client IPs

# --- Abuse protection (protects your free quotas) -----------------------------
# MAX_CONCURRENT_JOBS=1
# MAX_QUEUED_JOBS=5
# JOB_TIMEOUT_SECONDS=600
# GRACEFUL_SHUTDOWN_SECONDS=5     # close open connections (event streams) on SIGTERM
# SHUTDOWN_DRAIN_SECONDS=25       # then let running jobs finish (keep both within the
#                                 # host's SIGTERM-to-SIGKILL window; 5 + 20 on Render Free)
# JOBS_PER_IP_PER_HOUR=5
# JOBS_PER_IP_PER_DAY=10
# GLOBAL_JOBS_PER_DAY=100
# API_REQUESTS_PER_IP_PER_MINUTE=300
# MAX_EVENT_STREAMS_PER_IP=4
# MAX_TOPIC_CHARS=300
# MAX_INSTRUCTIONS_CHARS=1000
# MAX_REQUEST_BYTES=16384
# MAX_REPORT_CHARS=60000
# RESULT_CACHE_TTL_HOURS=24       # identical requests reuse a recent result
# JOB_RETENTION_DAYS=7            # finished jobs are deleted after this
# ALLOWED_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
