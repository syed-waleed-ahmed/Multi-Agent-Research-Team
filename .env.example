# ---------------------------------------------------------------------------
# Multi-Agent Research Team - environment configuration
# Copy this file to `.env` and fill in your credentials.
# ---------------------------------------------------------------------------

# Required API credentials
GROQ_API_KEY=your_groq_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Optional model tuning.
# The default balances quality with Groq free-tier token limits.
# For faster, cheaper runs use: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
GROQ_MAX_RETRIES=3

# Optional operational guard rails (leave commented out to disable).
# MAX_RPM=30            # cap requests-per-minute across the crew
# REQUEST_TIMEOUT=120   # per-agent execution timeout in seconds

# Optional logging.
LOG_LEVEL=INFO

# CrewAI telemetry and tracing are disabled by the app by default.
# To re-enable them, set these explicitly:
# CREWAI_DISABLE_TELEMETRY=false
# CREWAI_TRACING_ENABLED=true
