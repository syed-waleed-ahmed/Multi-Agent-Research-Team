# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg
*.egg-info/
pip-wheel-metadata/

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
.python-version

# Environment variables and secrets
.env
.env.*
# ...but keep the committed template that documents required variables.
!.env.example

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log

# Application output
reports/

# CrewAI runtime artifacts
**/outputs/
**/.crew_cache/

# Graphify cache only; generated graph outputs are kept under version control
graphify-out/cache/

# Jupyter
.ipynb_checkpoints/
